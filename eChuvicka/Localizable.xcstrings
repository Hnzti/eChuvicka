          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarm on connection loss"
          }
        }
      }
    },
    "settings.alarmDelay": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prodleva alarmu"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarm delay"
          }
        }
      }
    },
    "settings.disconnectAlarmHelp": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Po výpadku dat po zvolené době se ozve zvukový alarm a červený pruh na rodičovské jednotce."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After data is lost for the selected time, the parent unit plays an alarm and shows a red banner."
          }
        }
      }
    },
    "settings.lowBatteryAlert": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Varování při nízké baterii dítěte"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Low baby-battery warning"
          }
        }
      }
    },
    "settings.batteryThreshold": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Práh baterie"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Battery threshold"
          }
        }
      }
    },
    "settings.lowBatteryHelp": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pod prahem se na rodiči zobrazí varování a občas zazní upozornění. iOS hlásí baterii jen po cca 5 %."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Below the threshold the parent shows a warning and occasional alerts. iOS reports battery in about 5% steps."
          }
        }
      }
    },
    "settings.autoReconnect": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Obnovit spojení automaticky"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconnect automatically"
          }
        }
      }
    },
    "settings.autoReconnectHelp": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "První připojení je vždy ze seznamu (+ PIN). Po výpadku do 24 h se rodič sám znovu připojí ke stejnému zařízení bez PINu. PIN dítěte zůstává stejný i po restartu appky, aby důvěra 24 h fungovala."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The first connection is always from the list (+ PIN). After a drop within 24 hours, the parent reconnects to the same device without a PIN. The baby PIN stays the same after an app restart so 24-hour trust still works."
          }
        }
      }
    },
    "settings.security": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zabezpečení"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Security"
          }
        }
      }
    },
    "settings.requirePin": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyžadovat párovací PIN"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Require pairing PIN"
          }
        }
      }
    },
    "settings.pinHelp": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastavení se ukládá v zařízení. Bez PINu se na stejné síti může připojit kdokoliv s aplikací %@. Rodič toto nastavení nepřepisuje."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
