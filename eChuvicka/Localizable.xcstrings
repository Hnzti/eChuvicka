    "settings.voxHelp": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "VOX spustí přenos zvuku jen při detekci hluku. Když je vypnutý, dětská jednotka vysílá nepřetržitě."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "VOX starts audio only when noise is detected. When off, the baby unit transmits continuously."
          }
        }
      }
    },
    "settings.sensitivity": {
      "localizations": {
        "cs": {
          "stringUnit": {
